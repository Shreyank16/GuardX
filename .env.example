# Values prefixed with VITE_ are visible in the browser bundle.
# Never put Wazuh API users, passwords, indexer credentials, or JWT secrets in this file.

VITE_API_BASE_URL=/api
VITE_DATA_SOURCE=unconnected
VITE_ENVIRONMENT=LOCAL
VITE_WAZUH_VERSION=4.14.7

# Read by the Vite dev server only. Not shipped to the browser.
API_PROXY_TARGET=http://127.0.0.1:4000
