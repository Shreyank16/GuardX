# GuardX Backend Configuration Template
# Copy this file to backend/.env and replace placeholders with actual lab values.
# NEVER commit backend/.env to version control.

# Server Configuration (restricted to loopback 127.0.0.1)
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Wazuh Manager REST API (Port 55000 HTTPS)
# Authenticated via user/password exchanged for JWT bearer token
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=your_wazuh_api_user
WAZUH_API_PASSWORD=your_wazuh_api_password_here

# Wazuh Indexer / OpenSearch (Port 9200 HTTPS)
# Authenticated via HTTP Basic Authentication
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=your_wazuh_indexer_user
WAZUH_INDEXER_PASSWORD=your_wazuh_indexer_password_here

# TLS Certificate Verification
# Set path to the Wazuh root-ca.pem extracted from the Wazuh installation
# e.g., ./certs/root-ca.pem
WAZUH_CA_CERT_PATH=

# In lab environments with self-signed certs where CA is not yet imported,
# set to true ONLY if verified. Defaults to false (strict verification enabled).
WAZUH_ALLOW_SELF_SIGNED=false

# Gemini AI Threat Intelligence Configuration
# Set your Google Gemini API key to enable generative AI attack classification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
